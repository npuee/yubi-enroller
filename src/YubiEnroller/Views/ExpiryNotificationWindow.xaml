<Window x:Class="YubiEnroller.Views.ExpiryNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:YubiEnroller.Services"
        mc:Ignorable="d"
        Title="{Binding [ExpiryNotify_Title], Source={x:Static services:LocalizationService.Instance}}"
        Icon="pack://application:,,,/YubiEnroller;component/Resources/app.ico"
        Height="230" Width="440"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="True"
        Background="Transparent">

    <Border Background="#0C1322" BorderBrush="{Binding BorderColorBrush}" BorderThickness="1.5" CornerRadius="12" Padding="20,16" Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.7" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24" Padding="0" FontSize="11"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="DismissButton_Click" ToolTip="Dismiss" />
                
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{Binding IconBackgroundBrush}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding StatusIcon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeaderText}"
                                   FontSize="14" FontWeight="Bold" Foreground="{Binding HeaderForegroundBrush}" />
                        <TextBlock Text="{Binding SubtitleText}"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Message Body -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,14">
                <TextBlock Text="{Binding MessageBodyText}"
                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,8" />
                
                <!-- Metadata pill -->
                <Border Background="#141E33" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DeviceMetaText}"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" />
                </Border>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{Binding [ExpiryNotify_BtnDismiss], Source={x:Static services:LocalizationService.Instance}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="34" FontSize="11"
                        Click="DismissButton_Click" />

                <Button Grid.Column="2"
                        Content="{Binding [ExpiryNotify_BtnRenew], Source={x:Static services:LocalizationService.Instance}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="34" FontSize="11" FontWeight="Bold"
                        Click="RenewButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
