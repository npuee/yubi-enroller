<Window x:Class="YubiEnroller.Views.EnrollDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:YubiEnroller.Services"
        mc:Ignorable="d"
        Title="{Binding [EnrollDialog_Title], Source={x:Static services:LocalizationService.Instance}}"
        Icon="Resources/app.ico"
        Height="470" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderThickness="1"
        BorderBrush="{StaticResource BorderCardBrush}">

    <Border Background="{StaticResource BgDarkBrush}" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28" Padding="0" FontSize="12"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="CloseButton_Click" ToolTip="Close" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#0C344E" BorderBrush="#0284C7" BorderThickness="1" Margin="0,0,12,0">
                        <Image Source="Resources/app.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [EnrollDialog_Title], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding [EnrollDialog_Subtitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Active User Context Banner -->
            <Border Grid.Row="1" Background="#0C1425" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👤 " FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SubjectCommonName, StringFormat='{}User: {0}'}"
                               FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Main Form Content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Target User (Enroll on Behalf Of) -->
                    <StackPanel Margin="0,0,0,14" Visibility="{Binding IsEnrollmentAgentMode, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding [EnrollDialog_OnBehalfOfLabel], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,0,6" />
                        <TextBox Text="{Binding TargetUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DarkInputStyle}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding [EnrollDialog_OnBehalfOfHint], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Certificate Template -->
                    <TextBlock Text="{Binding [EnrollDialog_TemplateLabel], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding AvailableTemplates}" SelectedItem="{Binding SelectedTemplate}"
                              Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,16" />

                    <!-- YubiKey PIN -->
                    <TextBlock Text="{Binding [EnrollDialog_PinPrompt], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PinBox" Style="{StaticResource DarkPasswordStyle}" Margin="0,0,0,14"
                                 PasswordChanged="PinBox_PasswordChanged" />

                    <!-- Touch Sensor Prompt Banner -->
                    <Border Background="#2A1B05" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="8" Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding IsTouchRequired, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#452705" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="👆" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [TouchPrompt_Title], Source={x:Static services:LocalizationService.Instance}}"
                                           FontWeight="Bold" FontSize="13" Foreground="#FBBF24" />
                                <TextBlock Text="{Binding [TouchPrompt_Message], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="11" Foreground="#FDE68A" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Progress Stepper / Status -->
                    <Border Background="#0C1425" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                            Visibility="{Binding IsEnrolling, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <ProgressBar IsIndeterminate="True" Height="4" Background="#1E293B" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Error Alert -->
                    <Border Background="#2D1214" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Success Alert -->
                    <Border Background="#06281D" BorderBrush="#065F46" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10"
                            Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Action Row -->
            <Grid Grid.Row="3" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{Binding [CertDetails_BtnClose], Source={x:Static services:LocalizationService.Instance}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CloseButton_Click" />
                <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding EnrollCommand}"
                        IsEnabled="{Binding IsEnrolling, Converter={StaticResource InverseBoolConverter}}">
                    <Grid>
                        <TextBlock Text="{Binding [EnrollDialog_BtnSubmit], Source={x:Static services:LocalizationService.Instance}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsEnrolling, Converter={StaticResource InverseBoolToVisConverter}}" />
                        <TextBlock Text="{Binding [EnrollDialog_BtnEnrolling], Source={x:Static services:LocalizationService.Instance}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding IsEnrolling, Converter={StaticResource BoolToVisConverter}}" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
