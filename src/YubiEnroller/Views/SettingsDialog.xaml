<Window x:Class="YubiEnroller.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:YubiEnroller.Services"
        mc:Ignorable="d"
        Title="{Binding [Settings_Title], Source={x:Static services:LocalizationService.Instance}}"
        Height="640" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDarkBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        BorderThickness="1"
        BorderBrush="{StaticResource BorderCardBrush}">

    <Border Background="{StaticResource BgDarkBrush}" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Content="✕" Width="28" Height="28" Padding="0" FontSize="12"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="CloseButton_Click" ToolTip="Close" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#1E293B" Margin="0,0,12,0">
                        <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Settings_Title], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding [Settings_Subtitle], Source={x:Static services:LocalizationService.Instance}}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <!-- Language Selection -->
                    <TextBlock Text="{Binding [Settings_LanguageLabel], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <ComboBox x:Name="LanguageComboBox" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,16"
                              SelectionChanged="LanguageComboBox_SelectionChanged" />

                    <!-- CA Config -->
                    <TextBlock Text="{Binding [Settings_CaServerLabel], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="CaConfigBox" Style="{StaticResource DarkInputStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding [Settings_CaServerHint], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <!-- Template -->
                    <TextBlock Text="{Binding [Settings_TemplateLabel], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="TemplateBox" Style="{StaticResource DarkInputStyle}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding [Settings_TemplateHint], Source={x:Static services:LocalizationService.Instance}}"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <!-- Advanced / Diagnostic Section -->
                    <Border Background="#101726" BorderBrush="#1C273E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [Settings_AdvancedTitle], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />
                            <CheckBox x:Name="SimulatorCheckBox" VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Settings_SimulatorCheck], Source={x:Static services:LocalizationService.Instance}}"
                                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                            </CheckBox>
                            <TextBlock Text="{Binding [Settings_SimulatorHint], Source={x:Static services:LocalizationService.Instance}}"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="20,4,0,12" TextWrapping="Wrap" />

                            <Border Height="1" Background="#1D2B44" Margin="0,0,0,10" />

                            <!-- Diagnostic Log -->
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding [Settings_BtnOpenLog], Source={x:Static services:LocalizationService.Instance}}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,4" FontSize="11" Height="28" Click="OpenLogFileButton_Click" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding [Settings_LogsTitle], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding [Settings_LogsHint], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Configuration File -->
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding [Settings_BtnOpenConfig], Source={x:Static services:LocalizationService.Instance}}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,4" FontSize="11" Height="28" Click="OpenSettingsFileButton_Click" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding [Settings_ConfigTitle], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding [Settings_ConfigHint], Source={x:Static services:LocalizationService.Instance}}"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{Binding [Settings_BtnCancel], Source={x:Static services:LocalizationService.Instance}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click" />
                <Button Grid.Column="2"
                        Content="{Binding [Settings_BtnSave], Source={x:Static services:LocalizationService.Instance}}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
